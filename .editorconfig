# 统一编辑规则：换行、编码、缩进
# 参考：https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown 里行尾两个空格表示换行，不能裁剪
[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.xml]
indent_size = 4

# 补丁类二进制/产物不做任何文本处理
[*.{apk,dex,arsc,so,jar,png,webp,jpg,ttf,otf,proto,prof}]
insert_final_newline = false
trim_trailing_whitespace = false