# ============================================================
# 构建产物：一律不入库（用 scripts/ 重新生成，或走 Releases）
# ============================================================
build/
dist/
out/
*.apk
*.idsig
*.keystore
*.jks

# apktool 回编中间产物（aapt2 每次 build 都会重建）
apktool/build/
apktool/dist/

# ============================================================
# 反编译产物：可由「源 APK + scripts/」重新生成，不属源码
# 注：仓库里仍有存量文件被跟踪，迁移记录见 docs/REPO-PLAN.md
# ============================================================
jadx/

# ============================================================
# 编辑器 / 系统杂物
# ============================================================
.idea/
.vscode/
*.iml
local.properties
Thumbs.db
.DS_Store

# 设备原生库 stub（交叉编译用，不属源码）
*.so.stub
