<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="ltr"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="10.0" android:layoutDirection="ltr">
        <EditText android:id="@id/telnet_address" android:layout_width="0.0dp" android:layout_height="wrap_content" android:hint="@string/address" android:layout_weight="4.5" android:inputType="textMultiLine" android:layout_marginEnd="@dimen/margin_short" android:importantForAutofill="no" />
        <EditText android:id="@id/telnet_port" android:layout_width="0.0dp" android:layout_height="wrap_content" android:hint="@string/port" android:layout_weight="2.0" android:inputType="number" android:layout_marginEnd="@dimen/margin_short" android:importantForAutofill="no" />
        <Button android:id="@id/telnet_connect" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="@string/connect" android:layout_weight="3.5" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="@dimen/margin_short" />
    <LinearLayout android:orientation="horizontal" android:id="@id/telnet_messaging_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="10.0">
        <EditText android:id="@id/telnet_message" android:layout_width="0.0dp" android:layout_height="wrap_content" android:hint="@string/message" android:layout_weight="7.0" android:inputType="textMultiLine" android:layout_marginEnd="@dimen/margin_short" android:importantForAutofill="no" />
        <Button android:id="@id/telnet_send_message" android:layout_width="0.0dp" android:layout_height="match_parent" android:text="@string/send" android:layout_weight="3.0" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="@dimen/margin_short" />
    <androidx.recyclerview.widget.RecyclerView android:id="@id/telnet_message_list" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
